import { Button, GroupBox, ScrollView, TextEdit } from "std-widgets.slint";

// Reusable sub-components
component NavItem inherits Rectangle {
    in property <string> text: "";
    in property <color> bg_color: #ffffff;
    in property <color> accent_color: transparent;
    in property <color> text_color: #666666;

    height: 44px;
    background: bg_color;

    HorizontalLayout {
        height: 44px;
        spacing: 12px;
        padding: 0px;

        Rectangle {
            width: 4px;
            height: 20px;
            background: accent_color;
        }

        Text {
            text: text;
            font-size: 13px;
            color: text_color;
        }

        Rectangle { width: 100%; }
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> value: "";

    spacing: 0px;

    Text {
        text: label;
        width: 130px;
        font-size: 13px;
        color: #6c757d;
    }

    Text {
        text: value;
        width: 100%;
        font-size: 13px;
        color: #333333;
    }
}

// Connection Screen
export component ConnectionScreen inherits Window {
    title: "Reef - Connect to Device";
    width: 900px;
    height: 700px;

    in property <string> status_text: "";
    in property <bool> connecting: false;

    callback connect_device(string, string, string, string, string, string, string, string);
    callback load_profiles() -> [string];
    callback select_profile(string);
    callback save_profile(string, string, string, string, string, string);
    callback delete_profile(string);
    callback test_connection(string, string, string, string, string, string);

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        Rectangle {
            background: #007bff;
            height: 80px;
            width: 100%;

            VerticalLayout {
                spacing: 4px;
                padding: 20px;

                Text {
                    text: "Reef";
                    font-size: 24px;
                    color: #ffffff;
                    font-weight: 700;
                }

                Text {
                    text: "Cisco IOS XE Configuration Manager";
                    font-size: 14px;
                    color: #e0e0e0;
                }
            }
        }

        Rectangle { background: #dee2e6; height: 1px; width: 100%; }

        HorizontalLayout {
            spacing: 0px;
            height: 100%;

            VerticalLayout {
                width: 420px;
                spacing: 16px;
                padding: 32px;

                GroupBox {
                    title: "Device Profile";
                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            TextEdit { width: 100%; }
                            Button { text: "Save"; width: 60px; clicked => { } }
                            Button { text: "Delete"; width: 60px; clicked => { } }
                        }

                        Text {
                            text: "Select or create a device profile to connect to.";
                            font-size: 12px;
                            color: #6c757d;
                        }
                    }
                }

                Rectangle { background: #dee2e6; height: 1px; width: 100%; }

                GroupBox {
                    title: "Connection Method";
                    VerticalLayout {
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 4px;
                            Button { text: "SSH"; width: 100%; clicked => { } }
                            Button { text: "Telnet"; width: 100%; clicked => { } }
                            Button { text: "Serial"; width: 100%; clicked => { } }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Host/IP:"; width: 70px; }
                            TextEdit { text: ""; width: 100%; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Port:"; width: 70px; }
                            TextEdit { text: "22"; width: 80px; }
                            Text { text: "(22 SSH, 23 Telnet)"; font-size: 11px; color: #6c757d; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Username:"; width: 70px; }
                            TextEdit { text: "admin"; width: 100%; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Password:"; width: 70px; }
                            TextEdit { text: ""; width: 100%; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Enable:"; width: 70px; }
                            TextEdit { text: ""; width: 100%; }
                        }

                        Rectangle { height: 1px; width: 100%; background: #dee2e6; }

                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Serial Port:"; width: 70px; }
                            TextEdit { text: ""; width: 100%; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Baud Rate:"; width: 70px; }
                            TextEdit { text: "9600"; width: 100px; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: ""; width: 70px; }
                            Text { text: "Serial console uses physical serial port."; font-size: 11px; color: #6c757d; width: 100%; }
                        }
                    }
                }

                Rectangle { background: #dee2e6; height: 1px; width: 100%; }

                VerticalLayout {
                    spacing: 12px;

                    Text {
                        text: status_text;
                        font-size: 13px;
                        color: #dc3545;
                    }

                    Button {
                        text: "Connect";
                        width: 100%;
                        height: 40px;
                        enabled: !connecting;
                        clicked => {
                            connect_device("", "", "", "", "", "", "", "");
                        }
                    }

                    Text {
                        text: connecting ? "Connecting..." : "Ready to connect";
                        font-size: 11px;
                        color: #6c757d;
                    }
                }
            }

            Rectangle { background: #dee2e6; width: 1px; }

            VerticalLayout {
                width: 100%;
                spacing: 16px;
                padding: 32px;

                Text {
                    text: "Saved Profiles";
                    font-size: 18px;
                    font-weight: 700;
                }

                ScrollView {
                    height: 100%;
                    VerticalLayout { spacing: 8px; }
                }

                Rectangle { width: 100%; height: 100%; }
            }
        }

        Rectangle { background: #dee2e6; height: 1px; width: 100%; }

        HorizontalLayout {
            height: 40px;
            padding: 12px;

            Text {
                text: "Reef - Cisco IOS XE Configuration Manager";
                font-size: 11px;
                color: #6c757d;
            }

            Rectangle { width: 100%; }

            Text {
                text: "Not connected";
                font-size: 11px;
                color: #6c757d;
            }
        }
    }
}

// Main Device Window
export component MainWindow inherits Window {
    title: "Reef - Cisco IOS XE Configuration Manager";
    width: 1400px;
    height: 900px;

    in property <string> connection_status: "disconnected";
    in property <string> device_hostname: "-";
    in property <string> device_model: "-";
    in property <string> device_version: "-";
    in property <string> device_uptime: "-";
    in property <bool> is_connected: false;
    in property <string> selected_interface: "";
    in property <string> edit_description: "";
    in property <bool> edit_enabled: true;
    in property <string> edit_ip: "";
    in property <string> edit_mask: "255.255.255.0";
    in property <string> selected_vlan: "";
    in property <string> edit_vlan_id: "";
    in property <string> edit_vlan_name: "";
    in property <bool> edit_vlan_enabled: true;
    in property <string> edit_route_prefix: "";
    in property <string> edit_route_next_hop: "";
    in property <string> edit_route_distance: "";
    in property <string> edit_acl_name: "";
    in property <string> edit_acl_action: "permit";
    in property <string> edit_acl_protocol: "ip";
    in property <string> edit_acl_source: "any";
    in property <string> edit_acl_dest: "any";
    in property <string> edit_dhcp_name: "";
    in property <string> edit_dhcp_network: "";
    in property <string> edit_dhcp_mask: "255.255.255.0";
    in property <string> edit_dhcp_router: "";
    in property <string> edit_dhcp_dns: "";
    in property <string> edit_dhcp_lease: "";
    in property <string> edit_nat_type: "static";
    in property <string> edit_nat_inside: "";
    in property <string> edit_nat_outside: "";
    in property <bool> edit_ssh_enabled: true;
    property <string> edit_ssh_version: "2";
    property <string> edit_ssh_timeout: "";
    property <string> edit_ssh_retries: "";
    in property <string> edit_system_hostname: "";
    in property <string> edit_system_domain: "";
    in property <string> edit_system_dns: "";
    in property <string> diff_text: "No pending changes.";
    in property <string> disruptive_warning: "";
    in property <bool> has_pending_changes: false;
    in property <string> pending_text: "No pending changes";
    in property <color> pending_color: #6c757d;

    callback disconnect_device();
    callback refresh_device();
    callback save_config();
    callback preview_config();
    callback apply_config();
    callback rollback_config();
    callback confirm_disruptive(string);

    callback load_interfaces() -> [string];
    callback select_interface(string);
    callback save_interface(string, string, bool, string, string);

    callback load_vlans() -> [string];
    callback select_vlan(string);
    callback save_vlan(string, string, bool);

    callback load_routes() -> [string];
    callback save_route(string, string, string, string);

    callback load_acls() -> [string];
    callback select_acl(string);
    callback save_acl_rule(string, string, string, string, string, string, string);

    callback load_dhcp_pools() -> [string];
    callback select_dhcp_pool(string);
    callback save_dhcp_pool(string, string, string, string, string, string);

    callback load_nat_config() -> string;
    callback save_nat_config(string, string, string, string);

    callback load_ssh_config() -> string;
    callback save_ssh_config(bool, string, string, string);
    callback edit_ssh_enabled_changed(bool);

    callback load_system_config() -> string;
    callback save_system_config(string, string, string);

    VerticalLayout {
        spacing: 0px;
        padding: 0px;
        height: 100%;

        HorizontalLayout {
            height: 60px;
            spacing: 0px;
            padding: 16px;

            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "Reef";
                    font-size: 20px;
                    color: #007bff;
                    font-weight: 700;
                }

                Text {
                    text: device_hostname;
                    font-size: 14px;
                    font-weight: 700;
                    color: #333333;
                }
            }

            Rectangle { width: 100%; }

            HorizontalLayout {
                spacing: 12px;

                Text {
                    text: connection_status;
                    font-size: 12px;
                    color: #dc3545;
                    font-weight: 700;
                }

                Button {
                    text: "Refresh";
                    width: 80px;
                    enabled: is_connected;
                    clicked => { refresh_device(); }
                }

                Button {
                    text: "Disconnect";
                    width: 100px;
                    enabled: is_connected;
                    clicked => { disconnect_device(); }
                }
            }
        }

        Rectangle { background: #dee2e6; height: 1px; width: 100%; }

        Rectangle {
            background: #f8f9fa;
            height: 48px;

            HorizontalLayout {
                spacing: 16px;
                padding: 12px;

                Text { text: "Model:"; width: 50px; color: #6c757d; }
                Text { text: device_model; width: 100%; color: #333333; }

                Text { text: "Version:"; width: 60px; color: #6c757d; }
                Text { text: device_version; width: 100%; color: #333333; }

                Text { text: "Uptime:"; width: 60px; color: #6c757d; }
                Text { text: device_uptime; width: 100%; color: #333333; }

                Rectangle { width: 100%; }

                Button {
                    text: "Save Config";
                    width: 100px;
                    enabled: is_connected;
                    clicked => { save_config(); }
                }
            }
        }

        Rectangle { background: #dee2e6; height: 1px; width: 100%; }

        HorizontalLayout {
            height: 100%;
            spacing: 0px;

            Rectangle {
                background: #ffffff;
                width: 240px;

                VerticalLayout {
                    spacing: 0px;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 0px;

                        Text {
                            text: "Configuration";
                            font-size: 12px;
                            color: #6c757d;
                            font-weight: 700;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;

                        NavItem { text: "Overview"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                        NavItem { text: "Interfaces"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                        NavItem { text: "VLANs"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                        NavItem { text: "Routing"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                        NavItem { text: "ACLs"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                        NavItem { text: "DHCP"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                        NavItem { text: "NAT"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                        NavItem { text: "SSH / Access"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                        NavItem { text: "System"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                        NavItem { text: "Configuration"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                        NavItem { text: "Changes"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                        NavItem { text: "Backups / History"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                        NavItem { text: "Terminal"; bg_color: #ffffff; accent_color: transparent; text_color: #666666; }
                    }

                    Rectangle { width: 100%; height: 100%; }
                }
            }

            Rectangle { background: #dee2e6; width: 1px; }

            VerticalLayout {
                width: 100%;
                spacing: 0px;

                HorizontalLayout {
                    height: 44px;
                    spacing: 16px;
                    padding: 12px;

                    Text {
                        text: "Overview";
                        font-size: 18px;
                        font-weight: 700;
                        color: #333333;
                    }

                    Rectangle { width: 100%; }

                    Button {
                        text: "Preview";
                        width: 80px;
                        enabled: is_connected && has_pending_changes;
                        clicked => { preview_config(); }
                    }

                    Button {
                        text: "Apply";
                        width: 90px;
                        enabled: is_connected && has_pending_changes;
                        clicked => { apply_config(); }
                    }
                }

                Rectangle { background: #dee2e6; height: 1px; width: 100%; }

                ScrollView {
                    height: 100%;
                    VerticalLayout {
                        spacing: 16px;
                        padding: 20px;

                        GroupBox {
                            title: "Device Overview";
                            VerticalLayout {
                                spacing: 12px;

                                InfoRow { label: "Hostname:"; value: device_hostname; }
                                InfoRow { label: "Model:"; value: device_model; }
                                InfoRow { label: "IOS XE Version:"; value: device_version; }
                                InfoRow { label: "Uptime:"; value: device_uptime; }
                                InfoRow { label: "Connection:"; value: connection_status; }
                            }
                        }

                        GroupBox {
                            title: "Section Content";
                            VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: "Select a section from the sidebar to view and edit configuration.";
                                    font-size: 13px;
                                    color: #6c757d;
                                }

                                Rectangle { width: 100%; height: 1px; background: #dee2e6; }

                                Text {
                                    text: "Changes will appear here when you edit configuration.";
                                    font-size: 11px;
                                    color: #6c757d;
                                }
                            }
                        }

                        GroupBox {
                            title: "Configuration Preview";
                            VerticalLayout {
                                spacing: 8px;

                                TextEdit {
                                    text: diff_text;
                                    height: 150px;
                                    read-only: true;
                                }

                                Rectangle { background: #dee2e6; height: 1px; width: 100%; }

                                Text {
                                    text: disruptive_warning;
                                    font-size: 12px;
                                    color: #dc3545;
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle { background: #dee2e6; height: 1px; width: 100%; }

        HorizontalLayout {
            height: 56px;
            spacing: 16px;
            padding: 12px;

            Button {
                text: "Rollback";
                width: 90px;
                enabled: is_connected && has_pending_changes;
                clicked => { rollback_config(); }
            }

            Rectangle { width: 100%; }

            Text {
                text: pending_text;
                font-size: 12px;
                color: pending_color;
            }
        }
    }
}
