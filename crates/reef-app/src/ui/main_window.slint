import { Button, GroupBox, ScrollView, TextEdit } from "std-widgets.slint";

// Reusable sub-components
component NavItem inherits Rectangle {
    in property <string> text: "";
    in property <bool> active: false;
    callback activated();

    height: 40px;
    background: active ? #22332C : #18241F;
    clip: true;

    HorizontalLayout {
        height: 40px;
        spacing: 12px;
        padding: 0px;

        Rectangle {
            width: 3px;
            height: 22px;
            background: active ? #36D8A2 : transparent;
        }

        Text {
            text: text;
            font-size: 13px;
            color: active ? #36D8A2 : #A9BCB1;
            vertical-alignment: center;
        }

        Rectangle { width: 100%; }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.activated(); }
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> value: "";

    spacing: 0px;

    Text {
        text: label;
        width: 130px;
        font-size: 13px;
        color: #A9BCB1;
    }

    Text {
        text: value;
        width: 100%;
        font-size: 13px;
        color: #DCE9E2;
    }
}

// Connection Screen
export component ConnectionScreen inherits Window {
    title: "Reef - Connect to Device";
    width: 900px;
    height: 700px;
    min-width: 760px;
    min-height: 620px;
    background: #111916;

    in property <string> status_text: "";
    in property <bool> connecting: false;

    callback connect_device(string, string, string, string, string, string, string, string);
    callback load_profiles() -> [string];
    callback select_profile(string);
    callback save_profile(string, string, string, string, string, string);
    callback delete_profile(string);
    callback test_connection(string, string, string, string, string, string);

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        Rectangle {
            background: #18241F;
            height: 80px;
            width: 100%;

            VerticalLayout {
                spacing: 4px;
                padding: 20px;

                Text {
                    text: "Reef";
                    font-size: 24px;
                    color: #36D8A2;
                    font-weight: 700;
                }

                Text {
                    text: "Cisco IOS XE Configuration Manager";
                    font-size: 14px;
                    color: #A9BCB1;
                }
            }
        }

        Rectangle { background: #2B3B33; height: 1px; width: 100%; }

        HorizontalLayout {
            spacing: 0px;
            height: 100%;

            VerticalLayout {
                width: 420px;
                spacing: 16px;
                padding: 32px;

                GroupBox {
                    title: "Device Profile";
                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            TextEdit { width: 100%; }
                            Button { text: "Save"; width: 60px; clicked => { } }
                            Button { text: "Delete"; width: 60px; clicked => { } }
                        }

                        Text {
                            text: "Select or create a device profile to connect to.";
                            font-size: 12px;
                            color: #A9BCB1;
                        }
                    }
                }

                Rectangle { background: #2B3B33; height: 1px; width: 100%; }

                GroupBox {
                    title: "Connection Method";
                    VerticalLayout {
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 4px;
                            Button { text: "SSH"; width: 100%; clicked => { } }
                            Button { text: "Telnet"; width: 100%; clicked => { } }
                            Button { text: "Serial"; width: 100%; clicked => { } }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
            color: #DCE9E2; text: "Host/IP:"; width: 70px; }
                            TextEdit { text: ""; width: 100%; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
            color: #DCE9E2; text: "Port:"; width: 70px; }
                            TextEdit { text: "22"; width: 80px; }
                            Text {
             text: "(22 SSH, 23 Telnet)"; font-size: 11px; color: #A9BCB1; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
            color: #DCE9E2; text: "Username:"; width: 70px; }
                            TextEdit { text: "admin"; width: 100%; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
            color: #DCE9E2; text: "Password:"; width: 70px; }
                            TextEdit { text: ""; width: 100%; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
            color: #DCE9E2; text: "Enable:"; width: 70px; }
                            TextEdit { text: ""; width: 100%; }
                        }

                        Rectangle { height: 1px; width: 100%; background: #2B3B33; }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
            color: #DCE9E2; text: "Serial Port:"; width: 70px; }
                            TextEdit { text: ""; width: 100%; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
            color: #DCE9E2; text: "Baud Rate:"; width: 70px; }
                            TextEdit { text: "9600"; width: 100px; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
            color: #DCE9E2; text: ""; width: 70px; }
                            Text {
             text: "Serial console uses physical serial port."; font-size: 11px; color: #A9BCB1; width: 100%; }
                        }
                    }
                }

                Rectangle { background: #2B3B33; height: 1px; width: 100%; }

                VerticalLayout {
                    spacing: 12px;

                    Text {
                        text: status_text;
                        font-size: 13px;
                        color: #E36D79;
                    }

                    Button {
                        text: "Connect";
                        width: 100%;
                        height: 40px;
                        enabled: !connecting;
                        clicked => {
                            connect_device("", "", "", "", "", "", "", "");
                        }
                    }

                    Text {
                        text: connecting ? "Connecting..." : "Ready to connect";
                        font-size: 11px;
                        color: #A9BCB1;
                    }
                }
            }

            Rectangle { background: #2B3B33; width: 1px; }

            VerticalLayout {
                width: 100%;
                spacing: 16px;
                padding: 32px;

                Text {
            color: #DCE9E2;
                    text: "Saved Profiles";
                    font-size: 18px;
                    font-weight: 700;
                }

                ScrollView {
                    height: 100%;
                    VerticalLayout { spacing: 8px; }
                }

                Rectangle { width: 100%; height: 100%; }
            }
        }

        Rectangle { background: #2B3B33; height: 1px; width: 100%; }

        HorizontalLayout {
            height: 40px;
            padding: 12px;

            Text {
                text: "Reef - Cisco IOS XE Configuration Manager";
                font-size: 11px;
                color: #A9BCB1;
            }

            Rectangle { width: 100%; }

            Text {
                text: "Not connected";
                font-size: 11px;
                color: #A9BCB1;
            }
        }
    }
}

// Main Device Window
export component MainWindow inherits Window {
    title: "Reef - Cisco IOS XE Configuration Manager";
    width: 1280px;
    height: 820px;
    min-width: 980px;
    min-height: 640px;
    background: #111916;

    in property <string> connection_status: "disconnected";
    in property <string> device_hostname: "-";
    in property <string> device_model: "-";
    in property <string> device_version: "-";
    in property <string> device_uptime: "-";
    in property <bool> is_connected: false;
    in property <string> selected_interface: "";
    in property <string> edit_description: "";
    in property <bool> edit_enabled: true;
    in property <string> edit_ip: "";
    in property <string> edit_mask: "255.255.255.0";
    in property <string> selected_vlan: "";
    in property <string> edit_vlan_id: "";
    in property <string> edit_vlan_name: "";
    in property <bool> edit_vlan_enabled: true;
    in property <string> edit_route_prefix: "";
    in property <string> edit_route_next_hop: "";
    in property <string> edit_route_distance: "";
    in property <string> edit_acl_name: "";
    in property <string> edit_acl_action: "permit";
    in property <string> edit_acl_protocol: "ip";
    in property <string> edit_acl_source: "any";
    in property <string> edit_acl_dest: "any";
    in property <string> edit_dhcp_name: "";
    in property <string> edit_dhcp_network: "";
    in property <string> edit_dhcp_mask: "255.255.255.0";
    in property <string> edit_dhcp_router: "";
    in property <string> edit_dhcp_dns: "";
    in property <string> edit_dhcp_lease: "";
    in property <string> edit_nat_type: "static";
    in property <string> edit_nat_inside: "";
    in property <string> edit_nat_outside: "";
    in property <bool> edit_ssh_enabled: true;
    property <string> edit_ssh_version: "2";
    property <string> edit_ssh_timeout: "";
    property <string> edit_ssh_retries: "";
    in property <string> edit_system_hostname: "";
    in property <string> edit_system_domain: "";
    in property <string> edit_system_dns: "";
    in property <string> diff_text: "No pending changes.";
    in property <string> disruptive_warning: "";
    in property <bool> has_pending_changes: false;
    in property <string> pending_text: "No pending changes";
    in property <color> pending_color: #A9BCB1;

    // Tab visibility
    in property <bool> show_overview: true;
    in property <bool> show_interfaces: false;
    in property <bool> show_vlans: false;
    in property <bool> show_routing: false;
    in property <bool> show_acls: false;
    in property <bool> show_dhcp: false;
    in property <bool> show_nat: false;
    in property <bool> show_ssh: false;
    in property <bool> show_system: false;
    in property <bool> show_changes: false;
    in property <bool> show_backups: false;
    in property <bool> show_terminal: false;

    callback disconnect_device();
    callback refresh_device();
    callback save_config();
    callback preview_config();
    callback apply_config();
    callback rollback_config();
    callback confirm_disruptive(string);

    callback load_interfaces() -> [string];
    callback select_interface(string);
    callback save_interface(string, string, bool, string, string);

    callback load_vlans() -> [string];
    callback select_vlan(string);
    callback save_vlan(string, string, bool);

    callback load_routes() -> [string];
    callback save_route(string, string, string, string);

    callback load_acls() -> [string];
    callback select_acl(string);
    callback save_acl_rule(string, string, string, string, string, string, string);

    callback load_dhcp_pools() -> [string];
    callback select_dhcp_pool(string);
    callback save_dhcp_pool(string, string, string, string, string, string);

    callback load_nat_config() -> string;
    callback save_nat_config(string, string, string, string);

    callback load_ssh_config() -> string;
    callback save_ssh_config(bool, string, string, string);
    callback edit_ssh_enabled_changed(bool);

    callback load_system_config() -> string;
    callback save_system_config(string, string, string);

    callback set_active_tab(string);

    callback description_changed(string);
    callback enabled_changed(bool);
    callback ip_changed(string);
    callback mask_changed(string);

    VerticalLayout {
        spacing: 0px;
        padding: 0px;
        height: 100%;

        HorizontalLayout {
            height: 60px;
            spacing: 0px;
            padding: 16px;

            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "Reef";
                    font-size: 20px;
                    color: #36D8A2;
                    font-weight: 700;
                }

                Text {
                    text: device_hostname;
                    font-size: 14px;
                    font-weight: 700;
                    color: #DCE9E2;
                }
            }

            Rectangle { width: 100%; }

            HorizontalLayout {
                spacing: 12px;

                Text {
                    text: connection_status;
                    font-size: 12px;
                    color: #E36D79;
                    font-weight: 700;
                }

                Button {
                    text: "Refresh";
                    width: 80px;
                    enabled: is_connected;
                    clicked => { refresh_device(); }
                }

                Button {
                    text: "Disconnect";
                    width: 100px;
                    enabled: is_connected;
                    clicked => { disconnect_device(); }
                }
            }
        }

        Rectangle { background: #2B3B33; height: 1px; width: 100%; }

        Rectangle {
            background: #18241F;
            height: 48px;

            HorizontalLayout {
                spacing: 16px;
                padding: 12px;

                Text {
             text: "Model:"; width: 50px; color: #A9BCB1; }
                Text {
             text: device_model; width: 100%; color: #DCE9E2; }

                Text {
             text: "Version:"; width: 60px; color: #A9BCB1; }
                Text {
             text: device_version; width: 100%; color: #DCE9E2; }

                Text {
             text: "Uptime:"; width: 60px; color: #A9BCB1; }
                Text {
             text: device_uptime; width: 100%; color: #DCE9E2; }

                Rectangle { width: 100%; }

                Button {
                    text: "Save Config";
                    width: 100px;
                    enabled: is_connected;
                    clicked => { save_config(); }
                }
            }
        }

        Rectangle { background: #2B3B33; height: 1px; width: 100%; }

        HorizontalLayout {
            height: 100%;
            spacing: 0px;

            Rectangle {
                background: #18241F;
                width: 224px;

                VerticalLayout {
                    spacing: 0px;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 0px;

                        Text {
                            text: "Configuration";
                            font-size: 12px;
                            color: #A9BCB1;
                            font-weight: 700;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;

                        NavItem { text: "Overview"; active: show_overview; activated => { set_active_tab("overview"); } }
                        NavItem { text: "Interfaces"; active: show_interfaces; activated => { set_active_tab("interfaces"); } }
                        NavItem { text: "VLANs"; active: show_vlans; activated => { set_active_tab("vlans"); } }
                        NavItem { text: "Routing"; active: show_routing; activated => { set_active_tab("routing"); } }
                        NavItem { text: "ACLs"; active: show_acls; activated => { set_active_tab("acls"); } }
                        NavItem { text: "DHCP"; active: show_dhcp; activated => { set_active_tab("dhcp"); } }
                        NavItem { text: "NAT"; active: show_nat; activated => { set_active_tab("nat"); } }
                        NavItem { text: "SSH / Access"; active: show_ssh; activated => { set_active_tab("ssh"); } }
                        NavItem { text: "System"; active: show_system; activated => { set_active_tab("system"); } }
                        NavItem { text: "Changes"; active: show_changes; activated => { set_active_tab("changes"); } }
                        NavItem { text: "Backups / History"; active: show_backups; activated => { set_active_tab("backups"); } }
                        NavItem { text: "Terminal"; active: show_terminal; activated => { set_active_tab("terminal"); } }
                    }

                    Rectangle { width: 100%; height: 100%; }
                }
            }

            Rectangle { background: #2B3B33; width: 1px; }

            VerticalLayout {
                width: 100%;
                spacing: 0px;

                HorizontalLayout {
                    height: 44px;
                    spacing: 16px;
                    padding: 12px;

                    Text {
                        text: "Overview";
                        font-size: 18px;
                        font-weight: 700;
                        color: #DCE9E2;
                    }

                    Rectangle { width: 100%; }

                    Button {
                        text: "Preview";
                        width: 80px;
                        enabled: is_connected && has_pending_changes;
                        clicked => { preview_config(); }
                    }

                    Button {
                        text: "Apply";
                        width: 90px;
                        enabled: is_connected && has_pending_changes;
                        clicked => { apply_config(); }
                    }
                }

                Rectangle { background: #2B3B33; height: 1px; width: 100%; }

                ScrollView {
                    height: 100%;
                    VerticalLayout {
                        spacing: 16px;
                        padding: 20px;

                        GroupBox {
                            title: "Device Overview";
                            visible: show_overview;
                            VerticalLayout {
                                spacing: 12px;

                                InfoRow { label: "Hostname:"; value: device_hostname; }
                                InfoRow { label: "Model:"; value: device_model; }
                                InfoRow { label: "IOS XE Version:"; value: device_version; }
                                InfoRow { label: "Uptime:"; value: device_uptime; }
                                InfoRow { label: "Connection:"; value: connection_status; }
                            }
                        }

                        // Interfaces tab content
                        GroupBox {
                            title: "Interface Configuration";
                            visible: show_interfaces;
                            VerticalLayout {
                                spacing: 16px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
            color: #DCE9E2; text: "Interface:"; width: 100px; }

                                    Rectangle {
                                        width: 100%;
                                        height: 1px;
                                        background: #2B3B33;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 16px;
                                    Text {
            color: #DCE9E2; text: "Description:"; width: 120px; }
                                    TextEdit {
                                        text: edit_description;
                                        width: 300px;
                                        edited => { description_changed(self.text); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 16px;
                                    Text {
            color: #DCE9E2; text: "Admin State:"; width: 120px; }
                                    Button { text: "Toggle Enabled"; clicked => { enabled_changed(!edit_enabled); } }
                                    Text {
             text: "Enabled"; color: #A9BCB1; }
                                }

                                HorizontalLayout {
                                    spacing: 16px;
                                    Text {
            color: #DCE9E2; text: "IPv4 Address:"; width: 120px; }
                                    TextEdit {
                                        text: edit_ip;
                                        width: 140px;
                                        edited => { ip_changed(self.text); }
                                    }
                                    Text {
            color: #DCE9E2; text: "Subnet Mask:"; width: 90px; }
                                    TextEdit {
                                        text: edit_mask;
                                        width: 140px;
                                        edited => { mask_changed(self.text); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 16px;
                                    Button { text: "Save Changes"; clicked => {
                                        save_interface(selected_interface, edit_description, edit_enabled, edit_ip, edit_mask);
                                    } }
                                    Button { text: "Cancel"; clicked => { } }
                                    Rectangle { width: 100%; height: 1px; }
                                }

                                Rectangle { background: #2B3B33; height: 1px; width: 100%; }

                                Text {
                                    text: "Select an interface from the list to edit.";
                                    font-size: 13px;
                                    color: #A9BCB1;
                                }
                            }
                        }

                        // VLANs tab content
                        GroupBox {
                            title: "VLAN Configuration";
                            visible: show_vlans;
                            VerticalLayout {
                                spacing: 16px;

                                Text {
                                    text: "VLAN configuration editor coming soon.";
                                    font-size: 13px;
                                    color: #A9BCB1;
                                }
                            }
                        }

                        // Routing tab content
                        GroupBox {
                            title: "Routing Configuration";
                            visible: show_routing;
                            VerticalLayout {
                                spacing: 16px;

                                Text {
                                    text: "Routing configuration editor coming soon.";
                                    font-size: 13px;
                                    color: #A9BCB1;
                                }
                            }
                        }

                        // ACLs tab content
                        GroupBox {
                            title: "ACL Configuration";
                            visible: show_acls;
                            VerticalLayout {
                                spacing: 16px;

                                Text {
                                    text: "ACL configuration editor coming soon.";
                                    font-size: 13px;
                                    color: #A9BCB1;
                                }
                            }
                        }

                        // DHCP tab content
                        GroupBox {
                            title: "DHCP Configuration";
                            visible: show_dhcp;
                            VerticalLayout {
                                spacing: 16px;

                                Text {
                                    text: "DHCP configuration editor coming soon.";
                                    font-size: 13px;
                                    color: #A9BCB1;
                                }
                            }
                        }

                        // NAT tab content
                        GroupBox {
                            title: "NAT Configuration";
                            visible: show_nat;
                            VerticalLayout {
                                spacing: 16px;

                                Text {
                                    text: "NAT configuration editor coming soon.";
                                    font-size: 13px;
                                    color: #A9BCB1;
                                }
                            }
                        }

                        // SSH tab content
                        GroupBox {
                            title: "SSH & Access Configuration";
                            visible: show_ssh;
                            VerticalLayout {
                                spacing: 16px;

                                Text {
                                    text: "SSH configuration editor coming soon.";
                                    font-size: 13px;
                                    color: #A9BCB1;
                                }
                            }
                        }

                        // System tab content
                        GroupBox {
                            title: "System Configuration";
                            visible: show_system;
                            VerticalLayout {
                                spacing: 16px;

                                Text {
                                    text: "System configuration editor coming soon.";
                                    font-size: 13px;
                                    color: #A9BCB1;
                                }
                            }
                        }

                        GroupBox {
                            title: "Configuration Preview";
                            VerticalLayout {
                                spacing: 8px;

                                TextEdit {
                                    text: diff_text;
                                    height: 150px;
                                    read-only: true;
                                }

                                Rectangle { background: #2B3B33; height: 1px; width: 100%; }

                                Text {
                                    text: disruptive_warning;
                                    font-size: 12px;
                                    color: #E36D79;
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle { background: #2B3B33; height: 1px; width: 100%; }

        HorizontalLayout {
            height: 56px;
            spacing: 16px;
            padding: 12px;

            Button {
                text: "Rollback";
                width: 90px;
                enabled: is_connected && has_pending_changes;
                clicked => { rollback_config(); }
            }

            Rectangle { width: 100%; }

            Text {
                text: pending_text;
                font-size: 12px;
                color: pending_color;
            }
        }
    }
}
