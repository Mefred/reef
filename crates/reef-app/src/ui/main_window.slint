import { Button, ComboBox, GroupBox, ScrollView, TextEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Reef - Cisco IOS XE Configuration Manager";
    width: 1200px;
    height: 800px;

    in property <string> connection_status: "disconnected";
    in property <string> device_hostname: "-";
    in property <string> device_model: "-";
    in property <string> device_version: "-";
    in property <bool> is_connected: false;

    property <string> selected_interface: "";
    property <string> edit_description: "";
    property <bool> edit_enabled: true;
    property <string> edit_ip: "";
    property <string> edit_mask: "255.255.255.0";

    in property <string> diff_text: "No pending changes.";
    in property <string> disruptive_warning: "";

    property <string> conn_host: "10.0.0.1";
    property <string> conn_port: "22";
    property <string> conn_username: "admin";
    property <string> conn_password: "";
    property <string> conn_enable_secret: "";
    property <string> conn_transport: "SSH";

    // --- Callbacks from UI to Rust ---
    callback connect_device(string, string, string, string, string, string, string, string);
    callback disconnect_device();
    callback save_config();
    callback refresh_config();
    callback load_interfaces() -> [string];
    callback select_interface(string);
    callback save_interface(string, string, bool, string, string);
    callback preview_config();
    callback apply_config();
    callback rollback_config();
    callback confirm_disruptive(string);
    callback description_changed(string);
    callback enabled_changed(bool);
    callback ip_changed(string);
    callback mask_changed(string);

    // Function called from Rust to populate form fields
    public function set_interface_form(name: string, desc: string, enabled: bool, ip: string, mask: string) {
        selected_interface = name;
        edit_description = desc;
        edit_enabled = enabled;
        edit_ip = ip;
        edit_mask = mask;
    }

    VerticalLayout {
        spacing: 0px;

        // --- Top toolbar ---
        HorizontalLayout {
            spacing: 6px;
            padding: 6px;

            Text { text: "Reef"; font-size: 18px; }

            Text { text: "Host:"; width: 30px; }
            TextEdit { text: conn_host; width: 100px; }
            Text { text: "Port:"; width: 30px; }
            TextEdit { text: conn_port; width: 40px; }
            Text { text: "User:"; width: 30px; }
            TextEdit { text: conn_username; width: 80px; }
            Text { text: "Pass:"; width: 30px; }
            TextEdit { text: conn_password; width: 80px; }

            Text { text: conn_transport; width: 60px; }

            Button { text: "Connect"; enabled: !is_connected; clicked => {
                connect_device(conn_host, conn_port, conn_username, conn_password, conn_enable_secret, conn_transport, "", "");
            } }
            Button { text: "Disconnect"; enabled: is_connected; clicked => { disconnect_device(); } }

            Rectangle { width: 100%; height: 1px; }

            Button { text: "Save Config"; enabled: is_connected; clicked => { save_config(); } }
            Button { text: "Refresh"; enabled: is_connected; clicked => { refresh_config(); } }
        }

        Rectangle { background: #cccccc; height: 1px; }

        // --- Main split: sidebar + content ---
        HorizontalLayout {
            spacing: 0px;
            height: parent.height - 60px;

            // --- Sidebar ---
            VerticalLayout {
                width: 260px;
                spacing: 8px;
                padding: 8px;

                Text { text: "Devices"; font-size: 14px; }

                ScrollView {
                    height: 200px;
                    VerticalLayout {
                        spacing: 4px;
                        Button { text: "Switch1"; clicked => { } }
                        Button { text: "Router2"; clicked => { } }
                    }
                }

                Rectangle { background: #cccccc; height: 1px; }

                Text { text: "Status"; font-size: 12px; }
                Text { text: connection_status; color: #666666; }

                Rectangle { background: #cccccc; height: 1px; }

                Text { text: "Quick Actions"; font-size: 12px; }
                Button { text: "Backup Config"; enabled: is_connected; clicked => { save_config(); } }
                Button { text: "Refresh"; enabled: is_connected; clicked => { refresh_config(); } }
            }

            Rectangle { background: #cccccc; width: 1px; }

            // --- Content area ---
            VerticalLayout {
                spacing: 8px;
                padding: 8px;
                width: parent.width - 260px;

                // Device header
                HorizontalLayout {
                    spacing: 16px;
                    Text { text: device_hostname; font-size: 20px; }
                    Text { text: "|"; color: #999999; }
                    Text { text: device_model; color: #666666; }
                    Text { text: "|"; color: #999999; }
                    Text { text: device_version; color: #666666; }
                    Rectangle { width: 100%; height: 1px; }
                    Text { text: connection_status; }
                }

                Rectangle { background: #cccccc; height: 1px; }

                // Tab bar
                HorizontalLayout {
                    spacing: 0px;
                    Button { text: "Overview"; width: 100px; }
                    Button { text: "Interfaces"; width: 100px; }
                    Button { text: "IP Addressing"; width: 120px; }
                    Button { text: "VLANs"; width: 80px; }
                    Button { text: "Routing"; width: 100px; }
                    Button { text: "ACLs"; width: 80px; }
                    Button { text: "DHCP"; width: 80px; }
                    Button { text: "NAT"; width: 80px; }
                    Button { text: "SSH / Access"; width: 120px; }
                    Button { text: "System"; width: 100px; }
                    Rectangle { width: 100%; height: 1px; }
                }

                Rectangle { background: #cccccc; height: 1px; }

                // Interfaces screen content
                GroupBox {
                    title: "Interface Configuration";
                    VerticalLayout {
                        spacing: 8px;

                        Button { text: "Refresh Interfaces"; clicked => { load_interfaces(); } }

                        ScrollView {
                            width: 100%;
                            height: 180px;

                            VerticalLayout {
                                spacing: 4px;
                                // Interface rows populated by controller via select_interface callback
                            }
                        }

                        Rectangle { background: #cccccc; height: 1px; }

                        // Edit form for selected interface
                        GroupBox {
                            title: "Edit Interface: " + selected_interface;
                            VerticalLayout {
                                spacing: 8px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Description:"; width: 120px; }
                                    TextEdit { 
                                        text: edit_description; 
                                        width: 300px; 
                                        edited => { description_changed(self.text); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Admin State:"; width: 120px; }
                                    Button { text: "Toggle Enabled"; clicked => { enabled_changed(!edit_enabled); } }
                                    Text { text: "Enabled"; color: #666666; }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "IPv4 Address:"; width: 120px; }
                                    TextEdit { 
                                        text: edit_ip; 
                                        width: 140px; 
                                        edited => { ip_changed(self.text); }
                                    }
                                    Text { text: "Subnet Mask:"; width: 90px; }
                                    TextEdit { 
                                        text: edit_mask; 
                                        width: 140px; 
                                        edited => { mask_changed(self.text); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Save Changes"; clicked => {
                                        save_interface(selected_interface, edit_description, edit_enabled, edit_ip, edit_mask);
                                    } }
                                    Button { text: "Cancel"; clicked => { } }
                                    Rectangle { width: 100%; height: 1px; }
                                }
                            }
                        }

                        // Diff preview
                        GroupBox {
                            title: "Configuration Preview";
                            VerticalLayout {
                                spacing: 8px;
                                TextEdit {
                                    text: diff_text;
                                    height: 120px;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Preview Changes"; clicked => { preview_config(); } }
                                    Rectangle { width: 100%; height: 1px; }
                                }
                                Rectangle { background: #cccccc; height: 1px; }
                                Text { text: disruptive_warning; color: #dc3545; }
                            }
                        }
                    }
                }
            }
        }

        // --- Bottom: Apply / Rollback bar ---
        Rectangle { background: #eeeeee; height: 1px; }
        HorizontalLayout {
            spacing: 8px;
            padding: 8px;
            Rectangle { width: 100%; height: 1px; }
            Button { text: "Preview"; enabled: is_connected; clicked => { preview_config(); } }
            Button { text: "Apply"; enabled: is_connected; clicked => { apply_config(); } }
            Button { text: "Rollback"; enabled: is_connected; clicked => { rollback_config(); } }
        }
    }
}