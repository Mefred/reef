{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reef",
  "version": "0.1.0",
  "identifier": "com.reef.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir frontend build",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reef",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Network device management",
    "longDescription": "Reef is a desktop application for managing network devices and configurations.",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
